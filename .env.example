# Copy to `.env` and adjust.
# `make shell` and all Makefile targets export these variables into the active shell environment.

# Hugging Face read token. Your account must have been granted access to
# MahmoodLab/UNI2-h and MahmoodLab/CONCH.
HF_TOKEN=

# Where tiles and features are written (default: ./data).
# DATA_DIR=/path/to/rdmap-data

# Where predictions, tables and figures are written (default: ./outputs).
# OUTPUT_DIR=/path/to/rdmap-outputs

# Where backbone weights are cached (default: ~/.cache/rdmap).
# MODELS_DIR=/path/to/model-cache
